// Fishing gear: rods (one per method; better ones cast further), reels
// (spooled with their line: how hard a pull it takes, in kilograms, and how
// much line it holds, in metres), bait (one a cast; its hook suits fish of
// about one size), lures (they never wear out) and traps.
//
// From design_docs/fishing_skill/fishing_slice.md. Reaches and reel numbers
// are placeholders to tune; see venture_rpg::fishing for what they mean.
[
    (
        id: "ledger_rod",
        name: "Ledger rod",
        description: "A plain rod with a weight to hold the bait on the bottom. The tip twitches when something bites.",
        icon: "ledger_rod.png",
        value: 40,
        equip: Some((slots: [DominantHand], look: (style: Staff, main: (0.47, 0.31, 0.2), trim: (0.8, 0.8, 0.8)))),
        fishing: Some(Rod(method: Ledger, reach: 10.0, level: 1)),
    ),
    (
        id: "ash_ledger_rod",
        name: "Ash ledger rod",
        description: "A long, springy ledger rod of seasoned ash. It casts much further.",
        icon: "ash_ledger_rod.png",
        value: 2000,
        equip: Some((slots: [DominantHand], look: (style: Staff, main: (0.75, 0.6, 0.38), trim: (0.8, 0.8, 0.8)))),
        fishing: Some(Rod(method: Ledger, reach: 16.0, level: 18)),
    ),
    (
        id: "float_rod",
        name: "Float rod",
        description: "A light rod with a painted float, to hang the bait at any depth. Watch the float.",
        icon: "float_rod.png",
        value: 250,
        equip: Some((slots: [DominantHand], look: (style: Staff, main: (0.78, 0.67, 0.47), trim: (0.8, 0.8, 0.8)))),
        fishing: Some(Rod(method: Float, reach: 12.0, level: 5)),
    ),
    (
        id: "lure_rod",
        name: "Lure rod",
        description: "A stiff rod for casting lures far and drawing them back through the water.",
        icon: "lure_rod.png",
        value: 750,
        equip: Some((slots: [DominantHand], look: (style: Staff, main: (0.25, 0.25, 0.28), trim: (0.8, 0.8, 0.8)))),
        fishing: Some(Rod(method: Lure, reach: 18.0, level: 15)),
    ),
    (
        id: "wooden_reel",
        name: "Wooden reel",
        description: "A simple reel with a light line. Enough for small fish.",
        icon: "wooden_reel.png",
        value: 40,
        fishing: Some(Reel(strength: 3.0, capacity: 30.0, level: 1)),
    ),
    (
        id: "brass_reel",
        name: "Brass reel",
        description: "A smooth brass reel with a strong line and plenty of it. It lands bigger fish.",
        icon: "brass_reel.png",
        value: 3000,
        fishing: Some(Reel(strength: 8.0, capacity: 90.0, level: 18)),
    ),
    (
        id: "worm",
        name: "Worm",
        description: "A wriggling worm on a small hook. Insect-eaters and bottom-feeders can't resist it.",
        icon: "worm.png",
        stackable: true,
        value: 5,
        fishing: Some(Bait((diets: [Insect, Bottom], hook: Small))),
    ),
    (
        id: "sweetcorn",
        name: "Sweetcorn",
        description: "A few golden kernels on a small hook, for fish that graze.",
        icon: "sweetcorn.png",
        stackable: true,
        value: 5,
        fishing: Some(Bait((diets: [Herbivore], hook: Small))),
    ),
    (
        id: "paste_ball",
        name: "Paste ball",
        description: "A ball of bread paste on a medium hook, for bottom-feeders.",
        icon: "paste_ball.png",
        stackable: true,
        value: 8,
        fishing: Some(Bait((diets: [Bottom], hook: Medium))),
    ),
    (
        id: "shrimp_bits",
        name: "Shrimp bits",
        description: "Chopped shrimp. Crayfish and crabs come from all around for it: bait for traps.",
