        attack: (damage: "1d2", bonus: 0, speed: 0.6),
        wander_radius: 6.0,
        experience: 10,
        look: (shape: Rabbit, main: (0.55, 0.44, 0.33), trim: (0.93, 0.90, 0.85)),
    ),
    (
        id: "goblin",
