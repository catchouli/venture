// Skills: what characters get better at by doing it, each with its own level
// and experience (on the same curve as character levels). Shown on the
// Skills tab in this order. What each one actually involves is still being
// designed (see docs/vision.md); for now they're names and levels.
[
    (id: "fishing", name: "Fishing", description: "Catching fish in rivers, lakes and the sea.", icon: "skill_fishing.png"),
    (id: "woodcutting", name: "Woodcutting", description: "Felling trees for logs and timber.", icon: "skill_woodcutting.png"),
    (id: "mining", name: "Mining", description: "Digging ore and stone out of the ground.", icon: "skill_mining.png"),
    (id: "blacksmithing", name: "Blacksmithing", description: "Working metal into tools, weapons and armour.", icon: "skill_blacksmithing.png"),
]
