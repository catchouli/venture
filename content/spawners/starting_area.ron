// Where creatures live around the starting town. Each spawner keeps one
// creature alive within `radius` metres of `at`, bringing a new one
// `respawn_seconds` after it dies. Offsets are metres from the town square:
// (east, south).
[
    // Rabbits, all around the edge of town.
    (id: "rabbit_east", creature: "rabbit", at: StartingSettlement(offset: (32.0, 6.0)), radius: 8.0, respawn_seconds: 20.0),
    (id: "rabbit_west", creature: "rabbit", at: StartingSettlement(offset: (-34.0, 10.0)), radius: 8.0, respawn_seconds: 20.0),
    (id: "rabbit_south", creature: "rabbit", at: StartingSettlement(offset: (6.0, 34.0)), radius: 8.0, respawn_seconds: 20.0),
    (id: "rabbit_southeast", creature: "rabbit", at: StartingSettlement(offset: (28.0, 26.0)), radius: 8.0, respawn_seconds: 20.0),
    (id: "rabbit_southwest", creature: "rabbit", at: StartingSettlement(offset: (-26.0, 30.0)), radius: 8.0, respawn_seconds: 20.0),
    // Goblins, a little way out (on open ground: west of town is a lake).
    (id: "goblin_east", creature: "goblin", at: StartingSettlement(offset: (80.0, -40.0)), radius: 10.0, respawn_seconds: 45.0),
    (id: "goblin_south", creature: "goblin", at: StartingSettlement(offset: (10.0, 85.0)), radius: 10.0, respawn_seconds: 45.0),
    (id: "goblin_north", creature: "goblin", at: StartingSettlement(offset: (0.0, -85.0)), radius: 10.0, respawn_seconds: 45.0),
]
