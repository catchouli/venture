// The classes players choose from when they make a character. The first is
// the default (for characters made before classes existed).
//
// rules: hit_die is the health die per level (SRD 5.1: d10 for fighters, d6
// for wizards); mana_per_level and casting_stat set mana (see
// crates/rpg/src/derived.rs). stats are a new character's stats.
// starting_equipment is worn from the start (items in items/ that can be
// equipped); starting_abilities are known from the start (on top of everyone's,
// in new_characters.ron); abilities can be learned with ability points, from a
// level, for a cost.
[
    (
        id: "fighter",
        name: "Fighter",
        description: "Tough and strong, at home in the thick of a fight. Starts with a sword, wooden armour, and Whack.",
        rules: (hit_die: 10, mana_per_level: 3, casting_stat: Wisdom),
        stats: (strength: 15, dexterity: 12, constitution: 14, intelligence: 8, wisdom: 10),
        starting_equipment: ["training_sword", "wooden_chestguard", "wooden_legguards"],
        starting_abilities: ["whack"],
        abilities: [
            (ability: "cleave", level: 3, cost: 1),
            (ability: "second_wind", level: 5, cost: 2),
        ],
    ),
    (
        id: "mage",
        name: "Mage",
        description: "Frail but clever, striking from afar with spells. Starts with a staff, plain robes, and Air Blast.",
        rules: (hit_die: 6, mana_per_level: 8, casting_stat: Intelligence),
        stats: (strength: 8, dexterity: 12, constitution: 12, intelligence: 15, wisdom: 13),
        starting_equipment: ["wooden_staff", "plain_robes"],
        starting_abilities: ["air_blast"],
        abilities: [
            (ability: "frost_shard", level: 3, cost: 1),
            (ability: "arcane_bolt", level: 5, cost: 2),
        ],
    ),
]
