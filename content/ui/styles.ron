// The interface's named colours, text styles and bar colours, used by the
// layouts in layouts/ (see docs/ui-layouts.md). Colours are sRGB numbers
// from 0 to 1: (red, green, blue) or (red, green, blue, opacity).
(
    colours: {
        // The plain look (used where the theme has no picture).
        "window": (0.05, 0.04, 0.03, 0.85),
        "border": (0.85, 0.7, 0.4, 0.8),
        "slot": (1.0, 1.0, 1.0, 0.05),
        // Text.
        "title": (0.96, 0.9, 0.75),
        "text": (0.85, 0.85, 0.82),
        "quiet": (0.6, 0.6, 0.56),
        "key": (0.9, 0.85, 0.7),
        "white": (1.0, 1.0, 1.0),
        // The shade over something cooling down.
        "cooldown": (0.0, 0.0, 0.0, 0.6),
    },
    text: {
        "frame_name": (size: 14, colour: "title"),
        "bar_numbers": (size: 11, colour: "white", shadow: true),
        "bar_numbers_small": (size: 9, colour: "white", shadow: true),
        "slot_key": (size: 10, colour: "key", shadow: true),
        "slot_label": (size: 11, colour: "white"),
        "cooldown": (size: 15, colour: "white", shadow: true),
        "member_name": (size: 12, colour: "title"),
        // (Meant to be italic: give it an italic font from ui/ with `font: "....ttf"`.)
        "member_class": (size: 10, colour: "quiet"),
        "member_level": (size: 11, colour: "key", shadow: true),
        "invite_text": (size: 12, colour: "text"),
        "invite_seconds": (size: 11, colour: "quiet"),
        "button_label": (size: 12, colour: "title"),
    },
    // Each bar's fill, and the darker empty part behind it.
    bars: {
        "health": (fill: (0.75, 0.15, 0.12), back: (0.24, 0.05, 0.04)),
        "mana": (fill: (0.18, 0.35, 0.8), back: (0.05, 0.08, 0.24)),
        "experience": (fill: (0.85, 0.7, 0.3), back: (0.22, 0.16, 0.05)),
        // Time left to answer a party invitation.
        "timer": (fill: (0.8, 0.75, 0.6), back: (0.2, 0.18, 0.14)),
    },
)
